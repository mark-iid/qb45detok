' Environment, directories, ports and error handling
OPTION BASE 0
DECLARE SUB Handler ()
DIM Pal%(0 TO 15)
ON ERROR GOTO Trouble
ON TIMER(5) GOSUB Ticked
TIMER ON
CLEAR , , 2000
CHDIR "\"
MKDIR "QBTMP"
NAME "QBTMP" AS "QBTMP2"
RMDIR "QBTMP2"
FILES "*.BAS"
ENVIRON "QBTEST=1"
PRINT ENVIRON$("QBTEST")
DEF SEG = &HB800
POKE 0, 65
PRINT PEEK(0)
DEF SEG
OUT &H3C8, 0
PRINT INP(&H60)
WAIT &H3DA, 8
PALETTE USING Pal%(0)
ERROR 5
SYSTEM
END

Ticked:
TIMER OFF
RETURN

Trouble:
RESUME NEXT

SUB Handler
PRINT "handled"
END SUB
