DEFINT A-Z
DIM SHARED G
DIM Dyn(1)
TYPE T1
  A AS INTEGER
END TYPE
DIM SHARED R AS T1
OPEN "T.DAT" FOR OUTPUT AS #1
PRINT #1, TAB(5); "x"
PRINT #1, SPC(3); "y"
PRINT #1, TAB(5), "z"
CLOSE
ERASE Dyn
REDIM Dyn(5)
CONST C1 = 2 * 3
Sub1 G
END

SUB Sub1 (X)
  STATIC S(4)
  SHARED G
  S(0) = X
END SUB
