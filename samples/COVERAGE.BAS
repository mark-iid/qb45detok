' The last documented keywords the other samples miss
DEFINT A-Z
DIM L AS LONG
DIM D AS DOUBLE
DIM S AS SINGLE
DIM Txt AS STRING
A = 1 XOR 2
B = 1 EQV 2
C = 1 IMP 2
L = CVL(MKL$(7))
D = CVDMBF(MKDMBF$(1))
S = CVSMBF(MKSMBF$(1))
PRINT FREEFILE
PRINT ERDEV; ERDEV$
PRINT SADD(Txt); VARPTR$(A)
PRINT SETMEM(0)
OPEN "T.DAT" FOR INPUT AS #1
PRINT FILEATTR(1, 1)
PRINT INPUT$(2, 1)
CLOSE #1
PCOPY 0, 1
ON PEN GOSUB Handler
PEN ON
PEN OFF
PRINT PEN(0)
ON COM(1) GOSUB Handler
COM(1) ON
COM(1) OFF
ON UEVENT GOSUB Handler
UEVENT ON
END

Handler:
RETURN
