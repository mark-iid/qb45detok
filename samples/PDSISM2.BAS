' One PDS statement per pair of lines, each followed by PRINT 1 so the
' extent of an opcode whose operand count is unknown can still be read.
TYPE Rec
  Key AS INTEGER
  Name AS STRING * 10
END TYPE
DIM R AS Rec
OPEN "DB.MDB" FOR ISAM Rec "Table1" AS #1
PRINT 1
BEGINTRANS
PRINT 1
CHECKPOINT
PRINT 1
COMMITTRANS
PRINT 1
ROLLBACK
PRINT 1
CREATEINDEX #1, "Idx1", 0, "Key"
PRINT 1
SETINDEX #1, "Idx1"
PRINT 1
DELETEINDEX #1, "Idx1"
PRINT 1
MOVEFIRST #1
PRINT 1
MOVENEXT #1
PRINT 1
MOVEPREVIOUS #1
PRINT 1
MOVELAST #1
PRINT 1
SEEKEQ #1, 1
PRINT 1
SEEKGE #1, 1
PRINT 1
SEEKGT #1, 1
PRINT 1
INSERT #1, R
PRINT 1
RETRIEVE #1, R
PRINT 1
UPDATE #1, R
PRINT 1
DELETE #1
PRINT 1
DELETETABLE "DB.MDB", "Table1"
PRINT 1
SETUEV
PRINT 1
